{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "split_h5mu_test",
  "description": "This component test the output of the integration test of split_h5mu.",
  "type": "object",
  "$defs": {
    "inputs": {
      "title": "Inputs",
      "type": "object",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "format": "path",
          "exists": true,
          "description": "Path to sample summary csv.",
          "help_text": "Type: `file`, multiple: `False`, required, direction: `input`, example: `output_samples.csv`. "
        },
        "samples_dir": {
          "type": "string",
          "format": "path",
          "exists": true,
          "description": "Path to the directory containing the sample h5mu files.",
          "help_text": "Type: `file`, multiple: `False`, required, direction: `input`, example: `/path/to/h5mu_files`. "
        },
        "orig_input": {
          "type": "string",
          "format": "path",
          "exists": true,
          "description": "Path to the original input file.",
          "help_text": "Type: `file`, multiple: `False`, required, direction: `input`, example: `/path/to/original_input.h5mu`. "
        }
      }
    },
    "nextflow input-output arguments": {
      "title": "Nextflow input-output arguments",
      "type": "object",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "help_text": "Type: `string`, multiple: `False`, required, example: `output/`. "
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
