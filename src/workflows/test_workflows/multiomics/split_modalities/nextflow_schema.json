{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "split_modalities_test",
  "description": "This component test the output of the integration test of split_modalities.",
  "type": "object",
  "$defs": {
    "inputs": {
      "type": "object",
      "title": "Inputs",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Path to modality summary csv.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, required, direction: `input`, example: `output_types.csv`"
        },
        "mod_dir": {
          "type": "string",
          "description": "Path to the directory containing the modality h5mu files.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, required, direction: `input`, example: `/path/to/h5mu_files`"
        },
        "orig_input": {
          "type": "string",
          "description": "Path to the original input file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, required, direction: `input`, example: `/path/to/original_input.h5mu`"
        }
      },
      "required": [
        "input",
        "mod_dir",
        "orig_input"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
