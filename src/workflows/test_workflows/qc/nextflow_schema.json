{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qc_test",
  "description": "This component test the output of the integration test of the QC workflow.",
  "type": "object",
  "$defs": {
    "inputs": {
      "type": "object",
      "title": "Inputs",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Path to h5mu output.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, required, direction: `input`, example: `foo.final.h5mu`"
        },
        "og_input": {
          "type": "string",
          "description": "Path to the original h5mu file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, required, direction: `input`, example: `foo.h5mu`"
        }
      },
      "required": [
        "input",
        "og_input"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
