{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "split_modalities",
  "description": "A pipeline to split a multimodal mudata files into several unimodal mudata files.",
  "type": "object",
  "$defs": {
    "inputs": {
      "type": "object",
      "title": "Inputs",
      "description": "No description",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID of the sample.",
          "help_text": "type: `string`, required, example: `foo`"
        },
        "input": {
          "type": "string",
          "description": "Path to the sample.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, required, direction: `input`, example: `input.h5mu`"
        }
      },
      "required": [
        "id",
        "input"
      ]
    },
    "outputs": {
      "type": "object",
      "title": "Outputs",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Output directory containing multiple h5mu files.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `/path/to/output`"
        },
        "output_types": {
          "type": "string",
          "description": "A csv containing the base filename and modality type per output file.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `types.csv`"
        }
      },
      "required": [
        "output",
        "output_types"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/outputs"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
