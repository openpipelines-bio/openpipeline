// Give GPU-labelled processes access to the host's NVIDIA devices.
//
// Opt in by adding the following to the Nextflow command:
//
//   -c src/workflows/utils/gpu.config
//
// This is kept out of labels.config (which is injected into every built
// component) because most components carrying the 'gpu' label run fine without
// the devices being passed through, and requesting them fails on hosts without
// an NVIDIA runtime.
process {
  withLabel: gpu {
    accelerator = 1
    containerOptions = '--gpus all'
  }
}
