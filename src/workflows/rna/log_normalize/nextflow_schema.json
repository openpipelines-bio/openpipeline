{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "log_normalize",
  "description": "Performs normalization and subsequent log-transformation of raw count data.",
  "type": "object",
  "$defs": {
    "inputs": {
      "type": "object",
      "title": "Inputs",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "MuData file to transform.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, required, direction: `input`, example: `dataset.h5mu`"
        },
        "modality": {
          "type": "string",
          "default": "rna",
          "description": "Modality to process.",
          "help_text": "type: `string`, default: `rna`"
        },
        "layer": {
          "type": "string",
          "description": "Input layer containing raw counts. If not specified, .X is used.",
          "help_text": "type: `string`"
        }
      },
      "required": [
        "input"
      ]
    },
    "transormation options": {
      "type": "object",
      "title": "Transormation options",
      "description": "No description",
      "properties": {
        "target_sum": {
          "type": "integer",
          "description": "Normalize total counts to the specified amount. If not set, after normalization each observation (cell) \nwill have a total count equal to the median of total counts for observations (cells) before normalization.\n",
          "help_text": "type: `integer`"
        }
      }
    },
    "output slots": {
      "type": "object",
      "title": "Output slots",
      "description": "No description",
      "properties": {
        "output_layer": {
          "type": "string",
          "description": "Layer to write the log-transformed counts to.\n",
          "help_text": "type: `string`, required"
        }
      },
      "required": [
        "output_layer"
      ]
    },
    "output": {
      "type": "object",
      "title": "Output",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Destination path to the output.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output.h5mu`"
        }
      },
      "required": [
        "output"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/transormation options"
    },
    {
      "$ref": "#/$defs/output slots"
    },
    {
      "$ref": "#/$defs/output"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
