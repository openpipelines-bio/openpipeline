{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "demux",
  "description": "Convert `.bcl` files to `.fastq` files using bcl2fastq, bcl-convert or Cell Ranger mkfastq.\n",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "ID of the sample.",
      "help_text": "type: `string`, required, example: `foo`"
    },
    "input": {
      "type": "string",
      "description": "Directory containing BCL files",
      "format": "path",
      "exists": true,
      "help_text": "type: `string`, required, direction: `input`, example: `bcl_dir`"
    },
    "sample_sheet": {
      "type": "string",
      "description": "Pointer to the sample sheet",
      "format": "path",
      "exists": true,
      "help_text": "type: `string`, required, direction: `input`, example: `SampleSheet.csv`"
    },
    "demultiplexer": {
      "type": "string",
      "default": "bcl2fastq",
      "description": "The multiplexer to use, one of bclconvert or mkfastq",
      "enum": [
        "bclconvert",
        "bcl2fastq",
        "mkfastq"
      ],
      "help_text": "type: `string`, default: `bcl2fastq`, choices: `bclconvert`|`bcl2fastq`|`mkfastq`"
    },
    "ignore_missing": {
      "type": "boolean",
      "description": "Should the demultiplexer ignore missing entities (filter, ...)",
      "help_text": "type: `boolean`"
    },
    "output_fastq": {
      "type": "string",
      "description": "Output directory containig fastq files",
      "format": "path",
      "help_text": "type: `string`, required, direction: `output`, example: `fastq_dir`"
    },
    "output_fastqc": {
      "type": "string",
      "description": "Reports directory produced by FastQC",
      "format": "path",
      "help_text": "type: `string`, direction: `output`, example: `reports_dir`"
    },
    "output_multiqc": {
      "type": "string",
      "description": "Reports directory produced by MultiQC",
      "format": "path",
      "help_text": "type: `string`, direction: `output`, example: `reports_dir`"
    }
  },
  "required": [
    "id",
    "input",
    "sample_sheet",
    "output_fastq"
  ],
  "$defs": {
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
