{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "add_id",
  "description": "Add id of .obs. Also allows to make .obs_names (the .obs index) unique \nby prefixing the values with an unique id per .h5mu file.\n",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Path to the input .h5mu.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `input.h5mu`"
        },
        "input_id": {
          "type": "string",
          "description": "The input id.",
          "help_text": "type: `string`, multiple: False, required"
        },
        "obs_output": {
          "type": "string",
          "default": "sample_id",
          "description": "Name of the .obs column where to store the id.",
          "help_text": "type: `string`, multiple: False, default: `sample_id`"
        },
        "output": {
          "type": "string",
          "description": "Name of output MuData file.\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `output.h5mu`"
        },
        "make_observation_keys_unique": {
          "type": "boolean",
          "default": false,
          "description": "Join the id to the .obs index (.obs_names).",
          "help_text": "type: `boolean`, default: `False`"
        },
        "output_compression": {
          "type": "string",
          "description": "Compression format to use for the output AnnData and/or Mudata H5 files.\nBy default no compression is applied.\n",
          "enum": [
            "gzip",
            "lzf"
          ],
          "help_text": "type: `string`, multiple: False, example: `gzip`, choices: `gzip`|`lzf`"
        }
      },
      "required": [
        "input",
        "input_id"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
