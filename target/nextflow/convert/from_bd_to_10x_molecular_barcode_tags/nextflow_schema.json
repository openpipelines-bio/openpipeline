{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "from_bd_to_10x_molecular_barcode_tags",
  "description": "Convert the molecular barcode sequence SAM tag from BD format (MA) to 10X format (UB).\n",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Input SAM or BAM file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `input.bam`"
        },
        "output": {
          "type": "string",
          "description": "Output alignment file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `output.bam`"
        },
        "bam": {
          "type": "boolean",
          "default": false,
          "description": "Output a BAM file.",
          "help_text": "type: `boolean`, default: `False`"
        },
        "threads": {
          "type": "integer",
          "description": "Number of threads",
          "help_text": "type: `integer`, multiple: False"
        }
      },
      "required": [
        "input"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
