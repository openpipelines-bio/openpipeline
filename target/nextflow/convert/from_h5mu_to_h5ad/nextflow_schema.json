{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "from_h5mu_to_h5ad",
  "description": "Converts a h5mu file into a h5ad file.\n",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "default": "input.h5mu",
          "description": "Input MuData file",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, default: `input.h5mu`, direction: `input`"
        },
        "modality": {
          "type": "string",
          "default": "rna",
          "description": "Which modality from the input MuData file to process.\n",
          "help_text": "type: `string`, multiple: False, default: `rna`"
        },
        "output": {
          "type": "string",
          "default": "output.h5ad",
          "description": "Output AnnData file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, default: `output.h5ad`, direction: `output`"
        },
        "output_compression": {
          "type": "string",
          "description": "Compression format to use for the output AnnData and/or Mudata H5 files.\nBy default no compression is applied.\n",
          "enum": [
            "gzip",
            "lzf"
          ],
          "help_text": "type: `string`, multiple: False, example: `gzip`, choices: `gzip`|`lzf`"
        }
      },
      "required": [
        "input"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
