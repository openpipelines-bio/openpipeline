{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "from_bdrhap_to_h5mu",
  "description": "Convert the output of a BD Rhapsody pipeline v2.x to a MuData h5 file.\n",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "output_compression": {
          "type": "string",
          "description": "Compression format to use for the output AnnData and/or Mudata H5 files.\nBy default no compression is applied.\n",
          "enum": [
            "gzip",
            "lzf"
          ],
          "help_text": "type: `string`, multiple: False, example: `gzip`, choices: `gzip`|`lzf`"
        }
      }
    },
    "inputs": {
      "type": "object",
      "title": "Inputs",
      "description": "No description",
      "properties": {
        "id": {
          "type": "string",
          "description": "A sample ID.",
          "help_text": "type: `string`, multiple: False, required, example: `my_id`"
        },
        "input": {
          "type": "string",
          "description": "The output h5mu of a BD Rhapsody workflow.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `sample.h5mu`"
        }
      },
      "required": [
        "id",
        "input"
      ]
    },
    "outputs": {
      "type": "object",
      "title": "Outputs",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Output h5mu file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `output`, example: `output.h5mu`"
        }
      },
      "required": [
        "output"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/outputs"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
