{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "from_10xh5_to_h5mu",
  "description": "Converts a 10x h5 into an h5mu file.\n",
  "type": "object",
  "$defs": {
    "inputs": {
      "type": "object",
      "title": "Inputs",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "A 10x h5 file as generated by Cell Ranger.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `raw_feature_bc_matrix.h5`"
        },
        "input_metrics_summary": {
          "type": "string",
          "description": "A metrics summary csv file as generated by Cell Ranger.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `metrics_cellranger.csv`"
        }
      },
      "required": [
        "input"
      ]
    },
    "outputs": {
      "type": "object",
      "title": "Outputs",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Output h5mu file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `output.h5mu`"
        },
        "uns_metrics": {
          "type": "string",
          "default": "metrics_cellranger",
          "description": "Name of the .uns slot under which to QC metrics (if any).",
          "help_text": "type: `string`, multiple: False, default: `metrics_cellranger`"
        },
        "output_compression": {
          "type": "string",
          "description": "Compression format to use for the output AnnData and/or Mudata H5 files.\nBy default no compression is applied.\n",
          "enum": [
            "gzip",
            "lzf"
          ],
          "help_text": "type: `string`, multiple: False, example: `gzip`, choices: `gzip`|`lzf`"
        }
      }
    },
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "min_genes": {
          "type": "integer",
          "description": "Minimum number of counts required for a cell to pass filtering.",
          "help_text": "type: `integer`, multiple: False, example: `100`"
        },
        "min_counts": {
          "type": "integer",
          "description": "Minimum number of genes expressed required for a cell to pass filtering.",
          "help_text": "type: `integer`, multiple: False, example: `1000`"
        }
      }
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/outputs"
    },
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
