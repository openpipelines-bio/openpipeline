{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "download_file",
  "description": "Download a file.\n",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "URL to a file to download.",
          "help_text": "type: `string`, multiple: False, required"
        },
        "output": {
          "type": "string",
          "description": "Path where to store output.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `output`"
        },
        "verbose": {
          "type": "boolean",
          "default": false,
          "description": "Increase verbosity",
          "help_text": "type: `boolean`, default: `False`"
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
