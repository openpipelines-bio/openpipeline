{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mermaid",
  "description": "Generates a network from mermaid code.\n",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Input directory",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`"
        },
        "output": {
          "type": "string",
          "description": "Generated network as output.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `output`, example: `output.png`"
        },
        "output_format": {
          "type": "string",
          "description": "Output format for the generated image. By default will be inferred from the extension \nof the file specified with --output.\n",
          "enum": [
            "svg",
            "png",
            "pdf"
          ],
          "help_text": "type: `string`, multiple: False, choices: `svg`|`png`|`pdf`"
        },
        "width": {
          "type": "integer",
          "default": 800,
          "description": "Width of the page",
          "help_text": "type: `integer`, multiple: False, default: `800`"
        },
        "height": {
          "type": "integer",
          "default": 600,
          "description": "Height of the page",
          "help_text": "type: `integer`, multiple: False, default: `600`"
        },
        "background_color": {
          "type": "string",
          "default": "white",
          "description": "Background color for pngs/svgs (not pdfs)",
          "help_text": "type: `string`, multiple: False, default: `white`, example: `#F0F0F0`"
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
