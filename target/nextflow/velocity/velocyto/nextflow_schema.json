{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "velocyto",
  "description": "Runs the velocity analysis on a BAM file, outputting a loom file.",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Path to BAM file",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `input.bam`"
        },
        "transcriptome": {
          "type": "string",
          "description": "Path to GTF file",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `transcriptome.gtf`"
        },
        "barcode": {
          "type": "string",
          "description": "Valid barcodes file, to filter the bam. If --bcfile is not specified all the cell barcodes will be included.\nCell barcodes should be specified in the bcfile as the 'CB' tag for each read\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `barcodes.txt`"
        },
        "without_umi": {
          "type": "boolean",
          "default": false,
          "description": "foo",
          "help_text": "type: `boolean`, default: `False`"
        },
        "output": {
          "type": "string",
          "description": "Velocyto loom file",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `output`, example: `output.loom`"
        },
        "logic": {
          "type": "string",
          "default": "Default",
          "description": "The logic to use for the filtering.",
          "enum": [
            "Default",
            "Permissive10X",
            "Intermediate10X",
            "ValidatedIntrons10X",
            "Stricter10X",
            "ObservedSpanning10X",
            "Discordant10X",
            "SmartSeq2"
          ],
          "help_text": "type: `string`, multiple: False, default: `Default`, choices: `Default`|`Permissive10X`|`Intermediate10X`|`ValidatedIntrons10X`|`Stricter10X`|`ObservedSpanning10X`|`Discordant10X`|`SmartSeq2`"
        }
      },
      "required": [
        "input",
        "transcriptome",
        "output"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
