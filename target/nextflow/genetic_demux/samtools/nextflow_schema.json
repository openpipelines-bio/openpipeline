{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "samtools",
  "description": "Filter the BAM according to the instruction of scSplit via Samtools.",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "bam": {
          "type": "string",
          "description": "Input bam file for filtering.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `input.bam`"
        },
        "output": {
          "type": "string",
          "description": "Samtools output directory.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `samtools_out`"
        }
      },
      "required": [
        "bam"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
