{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vireo",
  "description": "Vireo is primarily designed for demultiplexing cells into donors by modelling of expressed alleles.",
  "type": "object",
  "$defs": {
    "input": {
      "type": "object",
      "title": "Input",
      "description": "No description",
      "properties": {
        "cell_data": {
          "type": "string",
          "description": "The cell genotype file in VCF format or cellSNP folder with sparse matrices.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `cell_data.vcf`"
        },
        "n_donor": {
          "type": "integer",
          "default": 2,
          "description": "Number of donors to demultiplex; can be larger than provided in donor_file.",
          "help_text": "type: `integer`, multiple: False, default: `2`"
        },
        "vartrix_data": {
          "type": "string",
          "description": "The cell genotype files in vartrix outputs.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `path/to/vatrix_outputs`"
        },
        "donor_file": {
          "type": "string",
          "description": "The donor genotype file in VCF format. Please filter the sample and region with bcftools first!",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`"
        },
        "geno_tag": {
          "type": "string",
          "default": "PL",
          "description": "The tag for donor genotype.",
          "enum": [
            "GT",
            "GP",
            "PL"
          ],
          "help_text": "type: `string`, multiple: False, default: `PL`, choices: `GT`|`GP`|`PL`"
        },
        "no_doublet": {
          "type": "boolean",
          "default": false,
          "description": "If use, not checking doublets.",
          "help_text": "type: `boolean`, multiple: False, default: `False`"
        },
        "n_init": {
          "type": "integer",
          "default": 50,
          "description": "Number of random initializations, when GT needs to learn.",
          "help_text": "type: `integer`, multiple: False, default: `50`"
        },
        "extra_donor": {
          "type": "integer",
          "default": 0,
          "description": "Number of extra donor in pre-cluster, when GT needs to learn.",
          "help_text": "type: `integer`, multiple: False, default: `0`"
        },
        "extra_donorMode": {
          "type": "string",
          "description": "Method for searching from extra donors. size: n_cell per donor; distance: GT distance between donors",
          "help_text": "type: `string`, multiple: False"
        },
        "force_learn_gt": {
          "type": "boolean",
          "default": false,
          "description": "If use, treat donor GT as prior only.",
          "help_text": "type: `boolean`, multiple: False, default: `False`"
        },
        "ase_mode": {
          "type": "boolean",
          "default": false,
          "description": "If use, turn on SNP specific allelic ratio.",
          "help_text": "type: `boolean`, multiple: False, default: `False`"
        },
        "no_plot": {
          "type": "boolean",
          "default": false,
          "description": "If use, turn off plotting GT distance.",
          "help_text": "type: `boolean`, multiple: False, default: `False`"
        },
        "rand_seed": {
          "type": "integer",
          "description": "Seed for random initialization",
          "help_text": "type: `integer`, multiple: False"
        },
        "cell_range": {
          "type": "string",
          "description": "Range of cells to process.",
          "help_text": "type: `string`, multiple: False"
        },
        "call_ambient_rnas": {
          "type": "boolean",
          "default": false,
          "description": "If use, detect ambient RNAs in each cell.",
          "help_text": "type: `boolean`, multiple: False, default: `False`"
        }
      }
    },
    "output": {
      "type": "object",
      "title": "Output",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Output directory",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `vireo`"
        }
      }
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
