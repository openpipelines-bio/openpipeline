{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scsplit",
  "description": "scsplit is a genotype-free demultiplexing methode of pooled single-cell RNA-seq, using a hidden state model for identifying genetically distinct samples within a mixed population.",
  "type": "object",
  "$defs": {
    "input": {
      "type": "object",
      "title": "Input",
      "description": "No description",
      "properties": {
        "vcf": {
          "type": "string",
          "description": "VCF from mixed BAM",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `input.vcf`"
        },
        "bam": {
          "type": "string",
          "description": "mixed sample BAM",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `input.bam`"
        },
        "bar": {
          "type": "string",
          "description": "barcodes whitelist",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `barcodes.txt`"
        },
        "tag": {
          "type": "string",
          "default": "CB",
          "description": "tag for barcode",
          "help_text": "type: `string`, multiple: False, default: `CB`"
        },
        "com": {
          "type": "string",
          "description": "common SNVs",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `common_snvs.txt`"
        },
        "num": {
          "type": "integer",
          "description": "expected number of mixed samples",
          "help_text": "type: `integer`, multiple: False"
        },
        "sub": {
          "type": "integer",
          "default": 10,
          "description": "maximum number of subpopulations in autodetect mode",
          "help_text": "type: `integer`, multiple: False, default: `10`"
        },
        "ems": {
          "type": "integer",
          "default": 30,
          "description": "number of EM repeats to avoid local maximum",
          "help_text": "type: `integer`, multiple: False, default: `30`"
        },
        "dbl": {
          "type": "number",
          "description": "correction for doublets. There will be no refinement on the results if this optional parameter is not specified or specified percentage is less than doublet rates detected during the run.",
          "help_text": "type: `number`, multiple: False"
        },
        "vcf_known": {
          "type": "string",
          "description": "known individual genotypes to limit distinguishing variants to available variants, so that users do not need to redo genotyping on selected variants, otherwise any variants could be selected as distinguishing variants.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `input`, example: `known_variants.vcf`"
        },
        "geno": {
          "type": "boolean",
          "default": false,
          "description": "generate sample genotypes based on the split result.",
          "help_text": "type: `boolean`, default: `False`"
        }
      }
    },
    "output": {
      "type": "object",
      "title": "Output",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Output directory",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `scSplit_out`"
        },
        "ref": {
          "type": "string",
          "description": "output Ref count matrix",
          "help_text": "type: `string`, multiple: False"
        },
        "alt": {
          "type": "string",
          "description": "output Alt count matrix",
          "help_text": "type: `string`, multiple: False"
        },
        "psc": {
          "type": "string",
          "description": "generated P(S|C)",
          "help_text": "type: `string`, multiple: False"
        }
      }
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
