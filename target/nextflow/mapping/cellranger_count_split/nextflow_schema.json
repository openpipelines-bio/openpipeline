{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cellranger_count_split",
  "description": "Split 10x Cell Ranger output directory into separate output fields.",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Output directory from a Cell Ranger count run.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `input_dir`"
        },
        "filtered_h5": {
          "type": "string",
          "description": "Output path for the h5 file storing the filtered counts.\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `filtered_feature_bc_matrix.h5`"
        },
        "metrics_summary": {
          "type": "string",
          "description": "Where to store the 'metrics_summary' CSV file.\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `metrics_summary.csv`"
        },
        "molecule_info": {
          "type": "string",
          "description": "Where to store Cell Ranger's 'molecule_info.h5' file.\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `molecule_info.h5`"
        },
        "bam": {
          "type": "string",
          "description": "Location of output BAM files.\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `possorted_genome_bam.bam`"
        },
        "bai": {
          "type": "string",
          "description": "Where to store the BAM index files.\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `possorted_genome_bam.bam.bai`"
        },
        "raw_h5": {
          "type": "string",
          "description": "Output path for the h5 file storing the raw counts.\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `raw_feature_bc_matrix.h5`"
        }
      },
      "required": [
        "input"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
