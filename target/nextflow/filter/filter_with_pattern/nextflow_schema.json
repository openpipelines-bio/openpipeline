{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "filter_with_pattern",
  "description": "Filter a MuData object based on gene names using a regex.\n",
  "type": "object",
  "$defs": {
    "inputs": {
      "type": "object",
      "title": "Inputs",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Input h5mu file",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `input.h5mu`"
        },
        "modality": {
          "type": "string",
          "default": "rna",
          "description": "Which modality from the input MuData file to process.\n",
          "help_text": "type: `string`, multiple: False, default: `rna`"
        },
        "var_gene_names": {
          "type": "string",
          "description": "The .var field containing the gene names to be filtered. If not provided, `.var.index` will be used.\n",
          "help_text": "type: `string`, multiple: False, example: `gene_symbol`"
        },
        "pattern": {
          "type": "array",
          "description": "A regex pattern to filter the gene names.\n",
          "items": {
            "type": "string"
          },
          "help_text": "type: `array`, multiple: True, required, example: `MIR\\d+;AL\\d+;LINC\\d+;AC\\d+;AP\\d+`"
        }
      },
      "required": [
        "input",
        "pattern"
      ]
    },
    "outputs": {
      "type": "object",
      "title": "Outputs",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Output h5mu file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `output.h5mu`"
        },
        "do_subset": {
          "type": "boolean",
          "default": false,
          "description": "Whether to subset before storing the output.",
          "help_text": "type: `boolean`, default: `False`"
        },
        "var_name_filter": {
          "type": "string",
          "default": "filter_with_pattern",
          "description": "In which .var slot to store a boolean array corresponding to which variables should be removed.",
          "help_text": "type: `string`, multiple: False, default: `filter_with_pattern`"
        },
        "output_compression": {
          "type": "string",
          "description": "Compression format to use for the output AnnData and/or Mudata H5 files.\nBy default no compression is applied.\n",
          "enum": [
            "gzip",
            "lzf"
          ],
          "help_text": "type: `string`, multiple: False, example: `gzip`, choices: `gzip`|`lzf`"
        }
      }
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/outputs"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
