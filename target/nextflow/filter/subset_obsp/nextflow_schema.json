{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subset_obsp",
  "description": "Create a subset of an .obsp field in a mudata file, by filtering the columns based on the values of an .obs column. The resulting subset is moved to an .obsm slot.\n",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "output_compression": {
          "type": "string",
          "description": "Compression format to use for the output AnnData and/or Mudata H5 files.\nBy default no compression is applied.\n",
          "enum": [
            "gzip",
            "lzf"
          ],
          "help_text": "type: `string`, multiple: False, example: `gzip`, choices: `gzip`|`lzf`"
        }
      }
    },
    "input": {
      "type": "object",
      "title": "Input",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "Input h5mu file",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `input.h5mu`"
        },
        "modality": {
          "type": "string",
          "default": "rna",
          "description": "Which modality from the input MuData file to process.\n",
          "help_text": "type: `string`, multiple: False, default: `rna`"
        },
        "input_obsp_key": {
          "type": "string",
          "description": "The .obsp field to be filtered.",
          "help_text": "type: `string`, multiple: False, required"
        },
        "input_obs_key": {
          "type": "string",
          "description": "The .obs column to filter on.",
          "help_text": "type: `string`, multiple: False, required"
        },
        "input_obs_value": {
          "type": "string",
          "description": "The value to filter on in the .obs column.",
          "help_text": "type: `string`, multiple: False, required"
        }
      },
      "required": [
        "input",
        "input_obsp_key",
        "input_obs_key",
        "input_obs_value"
      ]
    },
    "output": {
      "type": "object",
      "title": "Output",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Output h5mu file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `output.h5mu`"
        },
        "output_obsm_key": {
          "type": "string",
          "description": "The .obsm key to store the subset in.",
          "help_text": "type: `string`, multiple: False, required"
        }
      },
      "required": [
        "output_obsm_key"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
