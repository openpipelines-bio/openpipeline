{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conversion",
  "description": "A pipeline to convert .mtx, .h5 or .h5ad file formats to .h5mu.",
  "type": "object",
  "$defs": {
    "inputs": {
      "type": "object",
      "title": "Inputs",
      "description": "No description",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID of the sample.",
          "help_text": "type: `string`, multiple: False, required, example: `foo`"
        },
        "input": {
          "type": "string",
          "description": "Path to the sample to be converted.\nPossible format options include:\n  - .h5ad\n  - .h5\n  - .mtx\n",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `input.h5ad`"
        },
        "input_type": {
          "type": "string",
          "description": "Type of the input file",
          "enum": [
            "10xmtx",
            "10xh5",
            "h5ad"
          ],
          "help_text": "type: `string`, multiple: False, required, choices: `10xmtx`|`10xh5`|`h5ad`"
        }
      },
      "required": [
        "id",
        "input",
        "input_type"
      ]
    },
    "outputs": {
      "type": "object",
      "title": "Outputs",
      "description": "No description",
      "properties": {
        "output": {
          "type": "string",
          "description": "Name or template for the output files.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, direction: `output`, example: `output.h5mu`"
        }
      }
    },
    "conversion from h5ad": {
      "type": "object",
      "title": "Conversion from h5ad",
      "description": "No description",
      "properties": {
        "modality": {
          "type": "array",
          "description": "Name of the modality where the h5ad is stored in the h5mu object.",
          "items": {
            "type": "string"
          },
          "help_text": "type: `array`, multiple: True"
        }
      }
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/inputs"
    },
    {
      "$ref": "#/$defs/outputs"
    },
    {
      "$ref": "#/$defs/conversion from h5ad"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
