// Give GPU-labelled processes access to the host's NVIDIA devices.
//
// Applied automatically on the Viash Hub CI, which has a GPU available, via
// 'nextflow_labels_ci' in _viash.yaml. For a local or production run, opt in by
// adding the following to the Nextflow command:
//
//   -c src/workflows/utils/gpu.config
//
// This is kept out of labels.config and labels_ci.config because requesting the
// devices fails on hosts without an NVIDIA runtime, and several components carry
// the 'gpu' label while running fine without one. The GitHub Actions runners have
// no GPU, so they never include this file.
process {
  withLabel: gpu {
    accelerator = 1
    containerOptions = '--gpus all'
  }
}
