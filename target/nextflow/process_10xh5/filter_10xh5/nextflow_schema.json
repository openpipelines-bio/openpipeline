{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "filter_10xh5",
  "description": "Filter a 10x h5 dataset.\n",
  "type": "object",
  "$defs": {
    "arguments": {
      "type": "object",
      "title": "Arguments",
      "description": "No description",
      "properties": {
        "input": {
          "type": "string",
          "description": "An h5 file from the 10x genomics website.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `input`, example: `pbmc_1k_protein_v3_raw_feature_bc_matrix.h5`"
        },
        "output": {
          "type": "string",
          "description": "Output h5 file.",
          "format": "path",
          "exists": true,
          "help_text": "type: `string`, multiple: False, required, direction: `output`, example: `pbmc_1k_protein_v3_raw_feature_bc_matrix_filtered.h5`"
        },
        "min_library_size": {
          "type": "integer",
          "default": 0,
          "description": "Minimum library size.",
          "help_text": "type: `integer`, multiple: False, default: `0`"
        },
        "min_cells_per_gene": {
          "type": "integer",
          "default": 0,
          "description": "Minimum number of cells per gene.",
          "help_text": "type: `integer`, multiple: False, default: `0`"
        },
        "keep_feature_types": {
          "type": "array",
          "description": "Specify which feature types will never be filtered out",
          "items": {
            "type": "string"
          },
          "help_text": "type: `array`, multiple: True, example: `Antibody Capture`"
        },
        "verbose": {
          "type": "boolean",
          "default": false,
          "description": "Increase verbosity",
          "help_text": "type: `boolean`, default: `False`"
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "nextflow input-output arguments": {
      "type": "object",
      "title": "Nextflow input-output arguments",
      "description": "Input/output parameters for Nextflow itself. Please note that both publishDir and publish_dir are supported but at least one has to be configured.",
      "properties": {
        "publish_dir": {
          "type": "string",
          "description": "Path to an output directory.",
          "format": "path",
          "help_text": "type: `string`, required, direction: `output`, example: `output/`"
        }
      },
      "required": [
        "publish_dir"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/arguments"
    },
    {
      "$ref": "#/$defs/nextflow input-output arguments"
    }
  ]
}
